[Unit]
Description=Node Watcher - Auto heal & sync for 3X-UI / MHSanaei panel
After=network.target x-ui.service
Wants=x-ui.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/node-watcher
ExecStart=/usr/bin/python3 /opt/node-watcher/node_watcher.py
Restart=always
RestartSec=8
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
