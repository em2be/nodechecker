{
  "db_path": "/etc/x-ui/x-ui.db",
  "check_interval": 15,
  "log_file": "/var/log/node_watcher.log",
  "watched_inbounds": [
    {
      "id": 14,
      "port": 8443,
      "remark": "OB8443",
      "protocol": "vless",
      "listen": "",
      "stream_settings": {
        "network": "ws",
        "wsSettings": {
          "acceptProxyProtocol": false,
          "path": "/",
          "host": "",
          "headers": {},
          "heartbeatPeriod": 0
        },
        "security": "none"
      },
      "sniffing": {
        "enabled": false
      },
      "tag": "in-8443-tcp",
      "client_emails": ["OBusr8443"]
    }
  ]
}
