{
  "check_interval": 5,
  "inbound": {
    "port": 8443,
    "protocol": "vless",
    "remark": "Node-Outbound-8443",
    "enable": true,
    "expiryTime": 0,
    "settings": {
      "clients": [],
      "decryption": "none",
      "fallbacks": []
    },
    "streamSettings": {
      "network": "ws",
      "security": "none",
      "wsSettings": {
        "path": "/"
      }
    },
    "sniffing": {
      "enabled": true,
      "destOverride": ["http", "tls"]
    }
  }
}
